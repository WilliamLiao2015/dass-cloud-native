# 使用輕量且絕對拉得下來的 Alpine 作為基底
FROM alpine:3.19
# 在本地直接安裝 Alpine 官方倉庫提供的 pgbouncer 標準套件
RUN apk add --no-cache pgbouncer \
    && mkdir -p /var/log/pgbouncer /var/run/pgbouncer \
    && touch /var/log/pgbouncer/pgbouncer.log \
    && chown -R 70:70 /var/log/pgbouncer /var/run/pgbouncer

# 放入 PgBouncer 連線設定與帳號清單，讓容器能夠直接啟動
COPY --chown=70:70 pgbouncer.ini /etc/pgbouncer/pgbouncer.ini
COPY --chown=70:70 userlist.txt /etc/pgbouncer/userlist.txt

# 關鍵修正：改用物理 UID 70 進行身分切換，徹底繞過 passwd 檔案名稱解析死鎖
USER 70
# 預設開機命令
CMD ["pgbouncer", "/etc/pgbouncer/pgbouncer.ini"]
